# Python
__pycache__/
*.pyc

# Downloaded source data
# TFLink is a prefix match, not *.tsv, so that checked-in tables such as
# wikipathways/species.tsv are not swallowed. The .gz variants of the large
# TFLink tables are already covered by *.gz.
*.gmt
*.gz
TFLink_*.tsv

# BridgeDb identifier-mapping files
*.bridge
bridgedb/
bridgedb-metabolites/
gene.json
other.json

# linkset-creator jar (downloaded in CI)
linkset-creator-*.jar

# Generated pipeline outputs
# CHEMBL_MoA.py writes plain input.txt, which input_*.txt does not match.
input.txt
input_*.txt
*.xgmml
*.log
build/

# Helper-script outputs (configGenerator.sh / download-bridgedb.sh)
fileNames.config
fileDownloads.config
gdb.config
other.json

# Linkset-creator configs, generated by wp.py, reactome.py, CHEMBL_MoA.py,
# signor.py and aopwiki.py from their .config.template files (never hand-edited).
wikipathways/config/
reactome/config/
CHEMBL/config/
signor/config/
aopwiki/config/

# Reactome's pathway-gene table, downloaded by reactome.py.
NCBI2Reactome.txt

# SIGNOR's human network, downloaded by signor.py.
signor_9606.tsv
